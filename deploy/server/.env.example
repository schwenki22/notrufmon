NOTRUFMON_DOMAIN=notruf.example.net
DB_PASSWORD=change-me-long-random
# Password prompt for the web UI (Caddy Basic-Auth). Hash:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'PASSWORT'
# In SINGLE quotes (the hash contains $ signs).
WEB_USER=notruf
WEB_PASSWORD_HASH='$2a$14$REPLACE-WITH-OUTPUT-OF-HASH-PASSWORD'
